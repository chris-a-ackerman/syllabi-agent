# class-prep-agent — every secret / setting the agent needs.
# Copy to .env for local dry runs; on Maritime set these as agent environment variables.
# Never commit real values.

# --- Model provider -----------------------------------------------------------
# OPTIONAL. Maritime injects an LLM proxy token by default (the model is openai/gpt-5.4 via
# Maritime's proxy, billed to the Maritime account). Set this only to use your own
# Anthropic key instead (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# --- Canvas LMS ---------------------------------------------------------------
# Base URL of your Canvas instance (no trailing slash), e.g. https://canvas.mit.edu
CANVAS_BASE_URL=
# Personal access token. Canvas → Account → Settings → "+ New Access Token".
# Read-only use only: the agent never writes to Canvas.
CANVAS_API_TOKEN=

# --- Syllabi app --------------------------------------------------------------
# Base URL of the syllabi app that serves GET /agent/upcoming and GET /agent/course/:id
SYLLABI_BASE_URL=
# Bearer agent token issued by the syllabi app (its agent-token settings page / admin).
SYLLABI_AGENT_TOKEN=

# --- Telegram -----------------------------------------------------------------
# NOT needed. Telegram is paired in the Maritime dashboard (agent → Channels) and the agent
# sends with `maritime-telegram-send`. Maritime sets MARITIME_TELEGRAM_CONNECTED=1 itself.
# Only set these if you switch to your own @BotFather bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- NotebookLM (notebooklm-py's `notebooklm` CLI, unofficial) ------------------
# Install in the container: pip install "notebooklm-py[headless]"  (no Chromium with master-token auth)
# Auth lives in NOTEBOOKLM_HOME on the persistent volume. Log in ONCE with the dedicated agent
# Google account (never your main Gmail; a master token is a Google-account master credential):
#   NOTEBOOKLM_HOME=/data/notebooklm notebooklm login --master-token --account chris.classprep@gmail.com
# nlm.py keeps that directory 700 and storage_state.json / master_token.json 600.
NOTEBOOKLM_HOME=/data/notebooklm
# Optional alternative: inline auth JSON. SECRET: set it as a Maritime secret, never in a file here.
# NOTEBOOKLM_AUTH_JSON=
# Optional: Drive folder for podcasts, relative to the drive root (default Podcasts).
NLM_DRIVE_DIR=Podcasts
# Optional: seconds per nlm command (default 50; Maritime caps a command at 60).
NLM_DEADLINE=50

# --- Google Drive via rclone --------------------------------------------------
# Path to rclone config on the persistent volume. Create locally with
# `rclone config` (Google Drive remote, OAuth) and upload the resulting rclone.conf.
RCLONE_CONFIG=/data/rclone/rclone.conf
# rclone remote name + root folder for readings, e.g. gdrive:Readings
DRIVE_READINGS_ROOT=gdrive:Readings
# rclone remote + folder for podcasts (defaults to the same tree)
DRIVE_PODCASTS_ROOT=gdrive:Readings

# --- Runtime ------------------------------------------------------------------
# Persistent volume root. Everything runtime-written goes under here.
DATA_DIR=/data
# All schedule reasoning is in this zone. The cron jobs carry --tz America/New_York
# themselves (scripts/install-jobs.sh), so this only affects `date` in the shell.
TZ=America/New_York
