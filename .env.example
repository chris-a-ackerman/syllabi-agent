# class-prep-agent — every secret / setting the agent needs.
# Copy to .env for local dry runs; on Maritime set these as agent environment variables.
# Never commit real values.

# --- Model provider -----------------------------------------------------------
# OPTIONAL. Maritime injects an LLM proxy token by default (the model is openai/gpt-5.4 via
# Maritime's proxy, billed to the Maritime account). Set this only to use your own
# Anthropic key instead (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# --- Canvas LMS ---------------------------------------------------------------
# Base URL of your Canvas instance (https, no trailing slash), e.g. https://canvas.mit.edu
CANVAS_BASE_URL=
# Personal access token. Canvas → Account → Settings → "+ New Access Token". Set an expiration
# date (end of term) and revoke it after HW2: Canvas tokens can't be scoped, so this one could
# submit and post as you. The skill is GET-only; the agent's only Canvas write is `forum post` below.
# The skill reads CANVAS_TOKEN first and falls back to CANVAS_API_TOKEN; set either.
CANVAS_TOKEN=
CANVAS_API_TOKEN=

# --- Canvas agent forum (HW3, forum skill) ----------------------------------------
# The forum skill posts to ONE discussion topic only, and only from the `forum` cron job.
# CANVAS_FORUM_TOKEN: create a NEW token just for this (Canvas → Account → Settings), set it to
# expire shortly after Oct 7, and revoke it after grading. It falls back to CANVAS_TOKEN if unset.
# CANVAS_FORUM_TOPIC_ID has no default: the tool refuses to run without it.
CANVAS_FORUM_TOKEN=
CANVAS_FORUM_COURSE_ID=40577
CANVAS_FORUM_TOPIC_ID=

# --- Syllabi app --------------------------------------------------------------
# The app's Supabase functions base URL (https only). The syllabi skill calls
# GET $SYLLABI_BASE_URL/agent-upcoming?days=N (the edge function from syllabi SYL-92).
SYLLABI_BASE_URL=https://<project-ref>.supabase.co/functions/v1
# Agent token from the syllabi app: Settings → Agent access → New token (scope read:upcoming,
# expires after at most 180 days; shown once). Looks like syl_agent_ + 43 characters. It is
# read-only and revocable from the same card. Never commit it; the skill scrubs it from output.
SYLLABI_AGENT_TOKEN=
# Optional: the project's anon key, sent as the `apikey` header if the functions gateway asks
# for one (a 401 with a valid agent token is the symptom). Leave empty otherwise.
SYLLABI_ANON_KEY=
# Optional: endpoint path under the base URL (default /agent-upcoming) and per-request timeout
# in seconds (default 20; the agent has a 30 s reply budget).
SYLLABI_UPCOMING_PATH=/agent-upcoming
SYLLABI_TIMEOUT=20

# --- Telegram -----------------------------------------------------------------
# Telegram is paired in the Maritime dashboard (agent → Channels) and the agent sends with
# `maritime-telegram-send`. Maritime sets MARITIME_TELEGRAM_CONNECTED=1 itself.
# REQUIRED: Chris's Telegram chat id. Messages from this sender are the only ones that may start
# work or count as instructions (AGENTS.md hard rule 9); every other sender is ignored and logged.
TELEGRAM_CHAT_ID=
# Only set this if you switch to your own @BotFather bot.
TELEGRAM_BOT_TOKEN=

# --- NotebookLM (notebooklm-py's `notebooklm` CLI, unofficial) ------------------
# The container's python3 has no pip: install into a venv on the volume (see skills/nlm/SKILL.md
# Setup) and point NLM_BIN at it. No Chromium needed with master-token auth.
NLM_BIN=/data/venvs/nlm/bin/notebooklm
# Auth lives in NOTEBOOKLM_HOME on the persistent volume. Log in ONCE with the dedicated agent
# Google account (never your main Gmail; a master token is a Google-account master credential),
# passing the single-use oauth_token from a temporary Maritime secret (SKILL.md "Auth"):
#   NOTEBOOKLM_HOME=/data/notebooklm /data/venvs/nlm/bin/notebooklm login --master-token \
#     --account syllabi382@gmail.com --oauth-token "$NLM_OAUTH_TOKEN"
# NLM_OAUTH_TOKEN=   (SECRET, single-use: set it just before the login, remove it right after)
# nlm.py keeps that directory 700 and storage_state.json / master_token.json 600.
NOTEBOOKLM_HOME=/data/notebooklm
# Optional alternative: inline auth JSON. SECRET: set it as a Maritime secret, never in a file here.
# NOTEBOOKLM_AUTH_JSON=
# Optional: Drive folder for podcasts, relative to the drive root (default Podcasts).
NLM_DRIVE_DIR=Podcasts
# Optional: seconds per nlm command (default 50; Maritime caps a command at 60).
NLM_DEADLINE=50

# --- Google Drive via rclone --------------------------------------------------
# Path to rclone config on the persistent volume, for the DEDICATED AGENT Google account (not
# your main one), with its own OAuth client (rclone's shared client_id is being retired in 2026).
# On the laptop, `rclone config` a `gdrive` remote with that client_id/client_secret and
# `scope = drive.file` (the agent only touches files it created); then write this file with
# `type`, `client_id`, `client_secret`, `scope` and `token = {...}` via secret env vars, and
# `chmod 600` it (docs/deploy-maritime.md §7). It holds a refresh token and the client secret:
# never commit it, never log it; the drive skill refuses a group/other-readable file and scrubs
# its values from every output line. When the token expires or is revoked (DRIVE_AUTH), run
# `rclone config reconnect gdrive:` on the laptop and replace the token.
RCLONE_CONFIG=/data/rclone/rclone.conf
# rclone remote name + root folder that drive-put's <remote_dir> is relative to. Readings land in
# ClassPrep/Readings/<course>/<date>/, podcasts in ClassPrep/Podcasts/<course>-<date>.mp3. Share
# ClassPrep from the agent account with your main account by email (never link sharing).
DRIVE_ROOT=gdrive:ClassPrep
# Optional: seconds one drive-put may take (default 35: nlm-status gives it 40, Maritime's exec
# cap is 60). For a big file run drive-put in the background with DRIVE_TIMEOUT=300.
DRIVE_TIMEOUT=35
# Optional: path to the rclone binary when it is not on PATH (e.g. /data/bin/rclone).
DRIVE_RCLONE_BIN=

# --- Runtime ------------------------------------------------------------------
# Persistent volume root. Everything runtime-written goes under here.
DATA_DIR=/data
# Optional, brief skill: input bundle cap in characters (~40k tokens), fuzzy threshold below which
# a pre-class question is dropped as a hallucination, and characters per Telegram message.
# BRIEF_CAP_CHARS=160000
# BRIEF_MATCH_THRESHOLD=0.9
# BRIEF_TELEGRAM_LIMIT=4096
# All schedule reasoning is in this zone. The cron jobs carry --tz America/New_York
# themselves (scripts/install-jobs.sh), so this only affects `date` in the shell.
TZ=America/New_York
