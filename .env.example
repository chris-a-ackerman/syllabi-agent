# class-prep-agent — every secret / setting the agent needs.
# Copy to .env for local dry runs; on Maritime set these as agent environment variables.
# Never commit real values.

# --- Model provider -----------------------------------------------------------
# OPTIONAL. Maritime injects an LLM proxy token by default (the model is openai/gpt-5.4 via
# Maritime's proxy, billed to the Maritime account). Set this only to use your own
# Anthropic key instead (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# --- Canvas LMS ---------------------------------------------------------------
# Base URL of your Canvas instance (no trailing slash), e.g. https://canvas.mit.edu
CANVAS_BASE_URL=
# Personal access token. Canvas → Account → Settings → "+ New Access Token".
# Read-only use only: the agent never writes to Canvas.
CANVAS_API_TOKEN=

# --- Syllabi app --------------------------------------------------------------
# Base URL of the syllabi app that serves GET /agent/upcoming and GET /agent/course/:id
SYLLABI_BASE_URL=
# Bearer agent token issued by the syllabi app (its agent-token settings page / admin).
SYLLABI_AGENT_TOKEN=

# --- Telegram -----------------------------------------------------------------
# NOT needed. Telegram is paired in the Maritime dashboard (agent → Channels) and the agent
# sends with `maritime-telegram-send`. Maritime sets MARITIME_TELEGRAM_CONNECTED=1 itself.
# Only set these if you switch to your own @BotFather bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- NotebookLM (notebooklm-py, unofficial, cookie auth) ----------------------
# Not a secret value itself — the PATH to the cookie file on the persistent volume.
# Produce the file by logging in to notebooklm.google.com in a browser and exporting
# cookies (notebooklm-py's login helper / storage_state). Upload it to this path.
# Cookies expire; NLM_AUTH errors mean this file must be refreshed.
NLM_COOKIES_PATH=/data/secrets/notebooklm-cookies.json

# --- Google Drive via rclone --------------------------------------------------
# Path to rclone config on the persistent volume, for the DEDICATED AGENT Google account (not
# your main one). On the laptop run `rclone authorize "drive"` signed in as the agent account and
# write this file with `type = drive`, `scope = drive.file` (the agent only touches files it
# created) and `token = {...}`; then `chmod 600` it (docs/deploy-maritime.md §7). It holds a
# refresh token: never commit it, never log it; the drive skill refuses a group/other-readable
# file and scrubs its values from every output line. When the token expires or is revoked
# (DRIVE_AUTH), re-run `rclone authorize "drive"` and replace the token.
RCLONE_CONFIG=/data/rclone/rclone.conf
# rclone remote name + root folder that drive-put's <remote_dir> is relative to. Readings land in
# ClassPrep/Readings/<course>/<date>/, podcasts in ClassPrep/Podcasts/<course>-<date>.mp3. Share
# ClassPrep from the agent account with your main account by email (never link sharing).
DRIVE_ROOT=gdrive:ClassPrep
# Optional: seconds one drive-put may take (default 35: nlm-status gives it 40, Maritime's exec
# cap is 60). For a big file run drive-put in the background with DRIVE_TIMEOUT=300.
DRIVE_TIMEOUT=35
# Optional: path to the rclone binary when it is not on PATH (e.g. /data/bin/rclone).
DRIVE_RCLONE_BIN=

# --- Runtime ------------------------------------------------------------------
# Persistent volume root. Everything runtime-written goes under here.
DATA_DIR=/data
# All schedule reasoning is in this zone. The cron jobs carry --tz America/New_York
# themselves (scripts/install-jobs.sh), so this only affects `date` in the shell.
TZ=America/New_York
