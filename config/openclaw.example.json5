// Settings to MERGE into ~/.openclaw/openclaw.json (= /data/.openclaw/openclaw.json on Maritime):
//   openclaw config patch --file /data/syllabi-agent/config/openclaw.example.json5 --dry-run
//
// Schema is for OpenClaw 2026.7.1, the version Maritime's template runs. That version uses an
// `agents.list` ARRAY. The keyed `agents.entries` map in current OpenClaw docs is newer, and
// 2026.7.1 rejects it ("agents: Unrecognized key: entries").
// `main` must be in the list and marked default: with only brief-writer listed, OpenClaw would
// treat the first entry as the default agent.
//
// Maritime generates the rest of this file: gateway auth, the model (openai/gpt-5.4 via
// https://api.maritime.sh/api/llm/v1), a Browserbase MCP server, tools.deny ["browser"] and
// browser.enabled false. Back it up first (Maritime also keeps openclaw.json.last-good), and
// after a restart check that the change wasn't reverted.
//
// Exec policy is already security=full, ask=off (`openclaw approvals get`); nothing to set here.
{
  agents: {
    defaults: {
      // Leave `workspace` at its default (~/.openclaw/workspace = /data/.openclaw/workspace):
      // Maritime writes MARITIME.md there, and scripts/install-workspace.sh merges ours in.
      // Bootstrap already completed on first boot (BOOTSTRAP.md was removed), so skipBootstrap
      // is only a safety net.
      skipBootstrap: true,
      subagents: { maxConcurrent: 1, maxSpawnDepth: 1 },
    },
    list: [
      {
        id: "main",
        default: true,
        subagents: { allowAgents: ["brief-writer"], requireAgentId: true },
      },
      // Tool-less brief writer. Its own workspace only needs a tiny AGENTS.md
      // (or none): the full instructions travel in the sessions_spawn task.
      {
        id: "brief-writer",
        workspace: "~/.openclaw/workspace-brief-writer",
        skills: [],
        tools: {
          deny: [
            "read", "write", "edit", "apply_patch", "exec", "process",
            "browser", "web_fetch", "web_search", "canvas", "nodes",
            "cron", "gateway", "image", "message",
            "sessions_spawn", "sessions_send", "subagents",
          ],
        },
      },
    ],
  },
  // Fallback only, if sessions_spawn doesn't work out: run brief-writer through llm-task.
  // Uncomment both lines, and note that `tools.alsoAllow` replaces any existing array.
  // plugins: { entries: { "llm-task": { enabled: true } } },
  // tools: { alsoAllow: ["llm-task"] },
}
