# Secrets — never commit. Real values live on the Maritime volume (/data/secrets, /data/rclone)
# or in Maritime's environment settings.
.env
.env.*
!.env.example
*.cookies.json
notebooklm-cookies.json
storage_state*.json
master_token.json
.notebooklm/
notebooklm/
rclone.conf
secrets/
*.pem
*.key

# Runtime data — the agent writes these under /data on Maritime; local dry runs must not leak into git
data/
/data/
memory/prep-log.json
memory/
work/
# forum skill state (HW3): never commit it, wherever a local dry run puts it
forum-state.json
forum-state.json.*
forum.jsonl
forum-halt
logs/
readings/
podcasts/
*.mp3
*.m4a
# forum.py's lock file (memory/forum-state.json.lock) and atomic-write temp files
*.lock
*.tmp

# HW4: the GitHub Actions runner commits its memory under state/ (ids, hashes and decisions only;
# see state/README.md). These exceptions must stay below the runtime rules above. Post texts the
# driver writes to state/work/forum/ are scratch and stay out.
!/state/
!/state/**
/state/**/*.lock
/state/**/*.tmp
/state/work/**
!/state/work/forum/
!/state/work/forum/.gitkeep
# HW4-4 (SYL-115): delivered results (public forum content) are kept; sandbox/ scratch is not.
!/state/work/hw4/
!/state/work/hw4/result-*.py

# Tooling
# scripts/make-submission-zip.sh output
dist/
__pycache__/
*.pyc
.venv/
node_modules/
.DS_Store

# Maritime CLI link file
.maritime/
